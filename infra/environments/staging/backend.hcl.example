# Copy this file to backend.hcl (gitignored) and fill in the bucket name
# from `terraform output state_bucket` in infra/bootstrap. Then:
#   terraform init -backend-config=backend.hcl
bucket       = "eudext-erp-tfstate-<your-account-id>"
key          = "staging/terraform.tfstate"
region       = "ap-south-1"
use_lockfile = true
encrypt      = true
